{
  "name": "genieacs-nbi-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for GenieACS (TR-069 ACS) NBI: inspect CPE/ONT devices, faults, tasks and files without any write access.",
  "keywords": ["mcp", "model-context-protocol", "genieacs", "tr-069", "acs", "cwmp", "ont", "isp", "read-only"],
  "license": "Apache-2.0",
  "author": "genieacs-mcp contributors",
  "repository": { "type": "git", "url": "git+https://github.com/tempatsimpanku-pixel/genieacs-mcp.git" },
  "homepage": "https://github.com/tempatsimpanku-pixel/genieacs-mcp#readme",
  "bugs": { "url": "https://github.com/tempatsimpanku-pixel/genieacs-mcp/issues" },
  "mcpName": "io.github.tempatsimpanku-pixel/genieacs-mcp",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "bin": { "genieacs-nbi-mcp": "./dist/cli.js" },
  "files": ["dist", "docs", "genieacs.example.yaml", "LICENSE", "NOTICE", "README.md", "README.id.md", "SECURITY.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "check:server-json": "node scripts/check-server-json.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
